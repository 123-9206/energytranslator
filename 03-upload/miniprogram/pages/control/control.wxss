.container {
  padding-bottom: 40rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.refresh-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fff;
}

.device-count {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.refresh-btns {
  display: flex;
  align-items: center;
}

.add-device-btn {
  padding: 10rpx 24rpx;
  background: #07C160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.refresh-btn {
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  color: #07C160;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.loading-tip {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

.device-list {
  padding: 16rpx 24rpx;
}

.device-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 12rpx;
  border-left: 6rpx solid transparent;
}

.device-card.online {
  border-left-color: #07C160;
}

.device-card.offline {
  border-left-color: #ccc;
}

.device-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.device-status-dot.online {
  background: #07C160;
  box-shadow: 0 0 8rpx rgba(7, 193, 96, 0.4);
}

.device-status-dot.offline {
  background: #ccc;
}

.device-info {
  flex: 1;
  min-width: 0;
}

.device-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.device-meta {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.device-data {
  text-align: right;
  display: flex;
  align-items: baseline;
  margin-left: 16rpx;
}

.data-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #07C160;
}

.data-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.device-status-text {
  font-size: 24rpx;
  color: #ccc;
  padding: 8rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 12rpx;
}

.empty-add-btn {
  margin-top: 40rpx;
  padding: 20rpx 80rpx;
  background: #07C160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}

/* 控制面板 */
.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.control-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.panel-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.panel-body {
  padding: 24rpx 32rpx;
}

.control-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.control-label {
  font-size: 28rpx;
  color: #333;
}

.control-input {
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.device-realtime {
  background: #f8fff8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.realtime-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.rt-label {
  font-size: 26rpx;
  color: #999;
}

.rt-value {
  font-size: 26rpx;
  color: #07C160;
  font-weight: 600;
}

.panel-footer {
  padding: 20rpx 32rpx;
}

.send-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07C160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  text-align: center;
}

.send-btn::after {
  border: none;
}
