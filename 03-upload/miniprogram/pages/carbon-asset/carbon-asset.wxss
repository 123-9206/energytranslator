/* pages/carbon-asset/carbon-asset.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f7fa;
}
.loading-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

.hero-card {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  border-radius: 20rpx;
  padding: 44rpx 40rpx;
  margin-bottom: 24rpx;
  color: #fff;
}
.hero-card.warning { background: linear-gradient(135deg, #FA8C16 0%, #FA9E3C 100%); }
.hero-card.danger { background: linear-gradient(135deg, #FF4D4F 0%, #FF6B6B 100%); }
.hero-label { font-size: 28rpx; opacity: 0.9; }
.hero-value { display: flex; align-items: baseline; margin: 16rpx 0; }
.hero-sign { font-size: 44rpx; font-weight: 700; }
.hero-num { font-size: 72rpx; font-weight: 700; }
.hero-unit { font-size: 28rpx; opacity: 0.85; margin-left: 8rpx; }
.hero-sub { font-size: 24rpx; opacity: 0.85; }

.warn-card {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #FFF7E6;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
}
.warn-icon { font-size: 32rpx; flex-shrink: 0; }
.warn-text { font-size: 26rpx; color: #AD6800; line-height: 1.6; }

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.grid-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  text-align: center;
}
.g-val { display: block; font-size: 38rpx; font-weight: 700; color: #333; }
.g-val.status-safe { color: #07C160; }
.g-val.status-warning { color: #FA8C16; }
.g-val.status-danger { color: #FF4D4F; }
.g-label { font-size: 24rpx; color: #999; margin-top: 10rpx; }

.tip-card {
  background: #fff;
  border: 2rpx solid #eaf2ec;
  border-radius: 16rpx;
  padding: 28rpx;
}
.tip-text { font-size: 26rpx; color: #666; line-height: 1.6; }
