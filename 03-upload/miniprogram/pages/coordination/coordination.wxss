/* pages/coordination/coordination.wxss */
.page { padding: 24rpx; background: #f5f7fa; min-height: 100vh; }

.hero {
  background: linear-gradient(135deg, #0ea5e9, #6366f1);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sub { font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; }

.panel { background: #fff; border-radius: 20rpx; padding: 24rpx; }

.coord-toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f1f5f9;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}
.ct-label { font-size: 26rpx; color: #475569; }
.ct-input {
  flex: 1;
  background: #fff;
  border: 1rpx solid #cbd5e1;
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
  font-size: 28rpx;
  text-align: right;
}
.ct-unit { font-size: 24rpx; color: #64748b; }
.ct-btn { background: #2563eb; color: #fff; margin: 0; }

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.kpi-card {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 20rpx;
  text-align: center;
}
.kpi-num { font-size: 40rpx; font-weight: 700; }
.kpi-u { font-size: 22rpx; font-weight: 400; color: #94a3b8; margin-left: 4rpx; }
.kpi-lbl { font-size: 22rpx; color: #64748b; margin-top: 6rpx; }
.c-blue { color: #0ea5e9; }
.c-green { color: #10b981; }
.c-red { color: #ef4444; }
.c-purple { color: #8b5cf6; }

.tip { font-size: 22rpx; color: #94a3b8; margin: 18rpx 0 12rpx; }

.node-list { display: flex; flex-direction: column; gap: 14rpx; }
.node-item {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
}
.node-head { display: flex; align-items: center; gap: 10rpx; margin-bottom: 10rpx; }
.node-name { font-size: 28rpx; font-weight: 600; color: #1e293b; }
.tag-me { font-size: 20rpx; color: #fff; background: #10b981; border-radius: 8rpx; padding: 2rpx 10rpx; }
.tag-syn { font-size: 20rpx; color: #fff; background: #94a3b8; border-radius: 8rpx; padding: 2rpx 10rpx; }
.node-row { display: flex; align-items: center; gap: 10rpx; margin: 6rpx 0; }
.nr-l { font-size: 22rpx; color: #94a3b8; width: 110rpx; }
.nr-v { font-size: 24rpx; color: #334155; font-weight: 500; }
.node-action { font-size: 23rpx; color: #f59e0b; margin-top: 10rpx; line-height: 1.5; }

.algo { font-size: 22rpx; color: #94a3b8; line-height: 1.6; margin-top: 18rpx; background: #f1f5f9; padding: 16rpx; border-radius: 12rpx; }

.coord-toolbar-wrap { margin-bottom: 24rpx; }

.empty { text-align: center; color: #94a3b8; font-size: 26rpx; padding: 80rpx 0; }
.empty-ico { display: block; font-size: 64rpx; margin-bottom: 16rpx; }
