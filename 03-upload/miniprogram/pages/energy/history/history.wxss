.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.month-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.month-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #07C160;
}

.month-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin: 0 32rpx;
}

.calendar-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.week-header {
  display: flex;
  margin-bottom: 16rpx;
}

.week-day {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.calendar-cell {
  width: calc(100% / 7);
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
  position: relative;
  border-radius: 12rpx;
}

.calendar-cell.selected {
  background: #07C160;
  color: #fff;
}

.calendar-cell.selected .data-dot {
  background: #fff;
}

.calendar-cell.has-data {
  color: #07C160;
  font-weight: 600;
}

.data-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #07C160;
  margin-top: 2rpx;
}

.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.detail-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.detail-value.carbon { color: #07C160; }
.detail-value.cost { color: #fa5151; }

.detail-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.detail-count {
  text-align: center;
  font-size: 24rpx;
  color: #666;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.no-data {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}
