.container {
  padding-bottom: 160rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  gap: 16rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
}

.picker-item .arrow {
  font-size: 18rpx;
  color: #999;
  margin-left: 8rpx;
}

.picker-item.date {
  min-width: 180rpx;
  justify-content: center;
}

.filter-btns {
  display: flex;
  gap: 12rpx;
  margin-left: auto;
}

.btn-filter {
  padding: 12rpx 28rpx;
  background: #07C160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.btn-reset {
  padding: 12rpx 28rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.record-list {
  padding: 16rpx 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.record-icon.electricity {
  background: rgba(255, 193, 7, 0.15);
}

.record-icon.gas {
  background: rgba(255, 87, 34, 0.15);
}

.record-icon.water {
  background: rgba(33, 150, 243, 0.15);
}

.record-content {
  flex: 1;
  min-width: 0;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

.record-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #07C160;
}

.record-note {
  font-size: 24rpx;
  color: #999;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 12rpx;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
