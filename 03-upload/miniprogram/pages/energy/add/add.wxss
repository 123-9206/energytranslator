.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-input.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  font-size: 22rpx;
  color: #ccc;
  transform: rotate(90deg);
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding-right: 24rpx;
}

.input-wrap .form-input {
  flex: 1;
}

.input-unit {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-top: 48rpx;
}

.submit-btn.disabled {
  background: #9ed8b5;
}

.submit-btn::after {
  border: none;
}
