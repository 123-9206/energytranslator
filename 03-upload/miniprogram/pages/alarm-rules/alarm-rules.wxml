<view class="container">
  <!-- 顶部操作栏 -->
  <view class="top-bar">
    <text class="title">告警规则 ({{rules.length}})</text>
    <view class="add-btn" bindtap="onAddRule">+ 新增规则</view>
  </view>

  <!-- 加载中 -->
  <view class="loading-tip" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 规则列表 -->
  <view class="rule-list" wx:if="{{!loading}}">
    <view class="rule-card" wx:for="{{rules}}" wx:key="id">
      <view class="rule-header">
        <view class="rule-left">
          <switch checked="{{item.enabled}}" bindchange="onToggleRule" data-id="{{item.id}}" color="#07C160" size="mini"/>
          <text class="rule-name {{item.enabled ? '' : 'disabled'}}">{{item.name}}</text>
        </view>
        <view class="rule-actions">
          <text class="action-btn edit" bindtap="onEditRule" data-id="{{item.id}}">编辑</text>
          <text class="action-btn delete" bindtap="onDeleteRule" data-id="{{item.id}}">删除</text>
        </view>
      </view>
      <view class="rule-body">
        <text class="rule-desc">{{item.deviceName || '所有设备'}} - {{item.metric}} {{conditionLabels[item.condition]}} {{item.threshold}}</text>
        <view class="rule-severity {{item.severity}}">{{item.severity === 'critical' ? '严重' : item.severity === 'warning' ? '警告' : '提示'}}</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{rules.length === 0}}">
      <text class="empty-icon">🔔</text>
      <text class="empty-text">暂无告警规则</text>
      <text class="empty-hint">点击右上角添加规则</text>
    </view>
  </view>

  <!-- 新增/编辑表单弹窗 -->
  <view class="modal-mask" wx:if="{{showForm}}" bindtap="onCancelForm">
    <view class="modal-content" catchtap="">
      <view class="modal-title">{{editing ? '编辑规则' : '新增规则'}}</view>

      <view class="form-group">
        <text class="form-label">规则名称</text>
        <input class="form-input" placeholder="请输入规则名称" value="{{formData.name}}" bindinput="onNameInput" />
      </view>

      <view class="form-group">
        <text class="form-label">预警设备</text>
        <picker mode="selector" range="{{deviceNames}}" value="{{deviceIndex}}" bindchange="onDeviceChange">
          <view class="form-input picker {{deviceIndex === 0 ? 'placeholder' : ''}}">
            {{deviceNames[deviceIndex] || '所有设备（全局规则）'}} ▶
          </view>
        </picker>
        <text class="form-tip">从已添加设备中选择，未选则监控全部设备</text>
      </view>

      <view class="form-row">
        <view class="form-group flex1">
          <text class="form-label">监控指标</text>
          <picker mode="selector" range="{{metrics}}" range-key="label" value="{{metricIndex}}" bindchange="onMetricChange">
            <view class="form-input picker">{{metrics[metricIndex].label}} ▶</view>
          </picker>
        </view>
        <view class="form-group flex1">
          <text class="form-label">条件</text>
          <picker mode="selector" range="{{conditions}}" range-key="label" value="{{conditionIndex}}" bindchange="onConditionChange">
            <view class="form-input picker">{{conditions[conditionIndex].label}} ▶</view>
          </picker>
        </view>
      </view>

      <view class="form-row">
        <view class="form-group flex1">
          <text class="form-label">阈值</text>
          <input class="form-input" type="digit" placeholder="数值" value="{{formData.threshold}}" bindinput="onThresholdInput" />
        </view>
        <view class="form-group flex1">
          <text class="form-label">级别</text>
          <picker mode="selector" range="{{severities}}" range-key="label" value="{{severityIndex}}" bindchange="onSeverityChange">
            <view class="form-input picker">{{severities[severityIndex].label}} ▶</view>
          </picker>
        </view>
      </view>

      <view class="modal-btns">
        <view class="btn-cancel" bindtap="onCancelForm">取消</view>
        <view class="btn-submit" bindtap="onSubmitForm">{{editing ? '更新' : '添加'}}</view>
      </view>
    </view>
  </view>
</view>
