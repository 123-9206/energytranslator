/* pages/circuit-safety/circuit-safety.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

.loading-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* KPI 行 */
.kpi-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.kpi-cell {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  border: 2rpx solid #eaf2ec;
}
.kpi-cell.warning { border-color: #FFF1E0; background: #FFFCF7; }
.kpi-cell.danger { border-color: #FFECEC; background: #FFF8F8; }
.kpi-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
}
.kpi-cell.warning .kpi-num { color: #FA8C16; }
.kpi-cell.danger .kpi-num { color: #FF4D4F; }
.kpi-label { font-size: 24rpx; color: #999; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin: 8rpx 4rpx 20rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 60rpx 0;
}

/* 设备卡片 */
.device-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.device-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.device-name-wrap { display: flex; align-items: center; gap: 12rpx; }
.device-name { font-size: 32rpx; font-weight: 600; color: #333; }
.device-state {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}
.level-badge {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  color: #fff;
  background: #07C160;
}
.level-badge.safe { background: #07C160; }
.level-badge.warning { background: #FA8C16; }
.level-badge.danger { background: #FF4D4F; }

.device-score {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.score-num { font-size: 56rpx; font-weight: 700; color: #07C160; }
.score-num.warning { color: #FA8C16; }
.score-num.danger { color: #FF4D4F; }
.score-label { font-size: 26rpx; color: #999; }

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}
.metric-item { text-align: center; }
.metric-val { display: block; font-size: 32rpx; font-weight: 600; color: #333; }
.metric-key { font-size: 22rpx; color: #999; margin-top: 6rpx; }

.fault-block { margin-top: 20rpx; }
.fault-head {
  font-size: 26rpx;
  font-weight: 600;
  color: #FF4D4F;
  margin-bottom: 12rpx;
}
.fault-item {
  display: flex;
  flex-direction: column;
  background: #FFF8F8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}
.fault-item.warning { background: #FFFCF7; }
.fault-type { font-size: 26rpx; color: #FF4D4F; font-weight: 500; }
.fault-item.warning .fault-type { color: #FA8C16; }
.fault-detail { font-size: 24rpx; color: #888; margin-top: 6rpx; line-height: 1.5; }
.fault-ok {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #07C160;
}
