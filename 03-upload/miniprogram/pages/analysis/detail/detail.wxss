.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.loading-tip {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

.date-header {
  padding: 24rpx 0;
}

.date-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.overview-card {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 16rpx;
  margin-bottom: 24rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.ov-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.ov-value.green { color: #07C160; }
.ov-value.red { color: #fa5151; }

.ov-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
}

.record-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-row:last-child {
  border-bottom: none;
}

.r-type {
  width: 120rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.r-value {
  flex: 1;
  font-size: 28rpx;
  color: #07C160;
  font-weight: 600;
}

.r-time {
  font-size: 24rpx;
  color: #999;
}

.empty-text {
  text-align: center;
  padding: 40rpx 0;
  color: #ccc;
  font-size: 26rpx;
}

.suggest-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.suggest-list {
  display: flex;
  flex-direction: column;
}

.suggest-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.suggest-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #07C160;
  margin-top: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.suggest-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}
