<view class="container">
  <view class="loading-tip" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 日期标题 -->
    <view class="date-header">
      <text class="date-text">{{date}} 分析详情</text>
    </view>

    <!-- 数据概览 -->
    <view class="overview-card">
      <view class="overview-item">
        <text class="ov-value">{{summary.energy}}</text>
        <text class="ov-label">总能耗(kWh)</text>
      </view>
      <view class="overview-item">
        <text class="ov-value green">{{summary.carbon}}</text>
        <text class="ov-label">碳排放(kg)</text>
      </view>
      <view class="overview-item">
        <text class="ov-value red">{{summary.cost}}</text>
        <text class="ov-label">费用(元)</text>
      </view>
    </view>

    <!-- 记录明细 -->
    <view class="detail-card">
      <view class="card-title">记录明细 ({{records.length}}条)</view>
      <view class="record-list" wx:if="{{records.length > 0}}">
        <view class="record-row" wx:for="{{records}}" wx:key="id">
          <text class="r-type">{{item.type === 'electricity' ? '电力' : item.type === 'gas' ? '天然气' : '用水'}}</text>
          <text class="r-value">{{item.value}} {{item.unit || 'kWh'}}</text>
          <text class="r-time">{{item.recordTime || item.createdAt || ''}}</text>
        </view>
      </view>
      <view class="empty-text" wx:else>
        <text>当日暂无记录</text>
      </view>
    </view>

    <!-- 能效建议 -->
    <view class="suggest-card">
      <view class="card-title">能效建议</view>
      <view class="suggest-list">
        <view class="suggest-item" wx:for="{{suggestions}}" wx:key="index">
          <view class="suggest-dot"></view>
          <text class="suggest-text">{{item}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
