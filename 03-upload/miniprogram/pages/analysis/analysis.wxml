<view class="container">
  <!-- 周期选择 -->
  <view class="period-bar">
    <view class="period-item {{period === item.value ? 'active' : ''}}"
          wx:for="{{periods}}" wx:key="value"
          bindtap="onPeriodChange" data-value="{{item.value}}">
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-tip" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>分析中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 汇总卡片 -->
    <view class="summary-card">
      <view class="summary-item">
        <text class="s-value">{{summary.totalEnergy}}</text>
        <text class="s-label">总能耗(kWh)</text>
      </view>
      <view class="summary-item">
        <text class="s-value green">{{summary.totalCarbon}}</text>
        <text class="s-label">碳排放(kg)</text>
      </view>
      <view class="summary-item">
        <text class="s-value red">{{summary.totalCost}}</text>
        <text class="s-label">总费用(元)</text>
      </view>
      <view class="summary-item">
        <text class="s-value">{{summary.avgEnergy}}</text>
        <text class="s-label">日均(kWh)</text>
      </view>
    </view>

    <!-- 能耗趋势 -->
    <view class="chart-card">
      <view class="card-title">能耗趋势</view>
      <scroll-view scroll-x class="chart-scroll" wx:if="{{chartData.length > 0}}">
        <view class="chart-area">
          <view class="bar-group" wx:for="{{chartData}}" wx:key="date">
            <view class="bar" style="height: {{item.value / maxValue * 240}}rpx;" bindtap="goToDetail" data-date="{{item.date}}">
              <text class="bar-value">{{item.value}}</text>
            </view>
            <text class="bar-label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="empty-chart" wx:else>
        <text>暂无数据</text>
      </view>
    </view>

    <!-- 用能排名 -->
    <view class="rank-card">
      <view class="card-title">用能排名</view>
      <view class="rank-list" wx:if="{{topConsumers.length > 0}}">
        <view class="rank-item" wx:for="{{topConsumers}}" wx:key="rank">
          <view class="rank-badge {{item.rank <= 3 ? 'top' : ''}}">{{item.rank}}</view>
          <text class="rank-name">{{item.name}}</text>
          <text class="rank-value">{{item.value}} kWh</text>
        </view>
      </view>
      <view class="empty-chart" wx:else>
        <text>暂无排名数据</text>
      </view>
    </view>
  </block>
</view>
