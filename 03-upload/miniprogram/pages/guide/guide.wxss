.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ===== Tab Bar ===== */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}

.tab-item.active {
  color: #07C160;
  border-bottom-color: #07C160;
  font-weight: 600;
}

/* ===== Protocol Intro ===== */
.protocol-intro {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #e8f5e9, #f1f8e9);
  margin: 20rpx 24rpx 0;
  border-radius: 12rpx;
}

.intro-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.intro-text {
  flex: 1;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2e7d32;
  display: block;
  margin-bottom: 8rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

/* ===== Card ===== */
.card {
  background: #fff;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* ===== Architecture Flow ===== */
.arch-flow {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mqtt-flow {
  flex-wrap: wrap;
}

.arch-node {
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.arch-node.server {
  background: #e3f2fd;
  color: #1565c0;
}

.arch-node.broker {
  background: #fff3e0;
  color: #e65100;
}

.arch-node.device {
  background: #e8f5e9;
  color: #2e7d32;
}

.arch-arrow {
  font-size: 22rpx;
  color: #999;
  padding: 0 8rpx;
}

.arch-note {
  font-size: 24rpx;
  color: #888;
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ===== Field Table ===== */
.field-table {
  width: 100%;
}

.field-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
  font-size: 24rpx;
}

.field-row.header {
  font-weight: 700;
  color: #333;
  border-bottom: 2rpx solid #eee;
  padding-bottom: 12rpx;
}

.field-row.header .col-desc {
  color: #333;
}

.col-name {
  width: 200rpx;
  color: #1565c0;
  font-family: monospace;
  font-size: 22rpx;
  flex-shrink: 0;
}

.col-req {
  width: 80rpx;
  text-align: center;
  flex-shrink: 0;
}

.col-req.required {
  color: #e53935;
  font-weight: 700;
}

.col-desc {
  flex: 1;
  color: #666;
  line-height: 1.5;
  font-size: 24rpx;
}

/* ===== Code Block ===== */
.code-block {
  background: #1e1e1e;
  color: #d4d4d4;
  padding: 24rpx;
  border-radius: 8rpx;
  font-family: 'Courier New', monospace;
  font-size: 22rpx;
  line-height: 1.8;
  overflow-x: auto;
  white-space: pre;
}

/* ===== Info Block ===== */
.info-block {
  margin-bottom: 12rpx;
}

.info-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  display: block;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 26rpx;
  color: #1565c0;
  font-family: monospace;
}

.copyable {
  background: #e3f2fd;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  display: inline-block;
}

.info-note {
  font-size: 24rpx;
  color: #e65100;
  background: #fff3e0;
  padding: 12rpx 16rpx;
  border-radius: 6rpx;
  margin-top: 16rpx;
  line-height: 1.5;
}

/* ===== Param List ===== */
.param-list {
  margin-top: 12rpx;
}

.param-item {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.param-key {
  width: 160rpx;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.param-val {
  font-size: 24rpx;
  color: #333;
  font-family: monospace;
}

/* ===== Steps ===== */
.step-list {
  padding: 0;
}

.step-item {
  font-size: 26rpx;
  color: #444;
  line-height: 1.8;
  padding: 8rpx 0;
  padding-left: 8rpx;
}

.step-item .bold {
  font-weight: 700;
  color: #333;
}

/* ===== FAQ ===== */
.faq-section {
  margin-top: 30rpx;
}

.faq-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-q {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.faq-q::before {
  content: 'Q: ';
  color: #07C160;
}

.faq-a {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.faq-a::before {
  content: 'A: ';
  color: #1565c0;
}

/* ===== Shop ===== */
.shop-category {
  margin: 20rpx 24rpx;
}

.shop-cat-title {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
  border-bottom: 2rpx solid #07C160;
}

.cat-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.cat-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.shop-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.shop-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.shop-brand {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.shop-price {
  font-size: 28rpx;
  color: #e53935;
  font-weight: 600;
}

.shop-model {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
  display: block;
}

.shop-desc {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  margin-bottom: 8rpx;
  display: block;
}

.shop-channel {
  font-size: 24rpx;
  color: #1565c0;
  display: block;
}

/* ===== VPP Type Card ===== */
.vpp-type-card {
  background: #f8faf8;
  border-radius: 10rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #07C160;
}

.vpp-type-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.vpp-type-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.vpp-type-info {
  flex: 1;
}

.vpp-type-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.vpp-type-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.vpp-type-detail {
  background: #fff;
  border-radius: 8rpx;
  padding: 16rpx;
}

.vpp-detail-row {
  display: flex;
  padding: 6rpx 0;
}

.vpp-detail-row + .vpp-detail-row {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 10rpx;
  margin-top: 4rpx;
}

.vpp-detail-label {
  width: 160rpx;
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

.vpp-detail-value {
  flex: 1;
  font-size: 22rpx;
  color: #555;
  line-height: 1.5;
  font-family: monospace;
}

/* ===== Brand List ===== */
.brand-list {
  padding: 0;
}

.brand-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.brand-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.brand-models {
  font-size: 24rpx;
  color: #1565c0;
  display: block;
  margin-bottom: 4rpx;
  font-family: monospace;
}

.brand-note {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
  display: block;
}

/* ===== VPP Step List ===== */
.vpp-step-list {
  padding: 0;
}

.vpp-step-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.vpp-step-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.vpp-step-num {
  width: 48rpx;
  height: 48rpx;
  background: #07C160;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 2rpx;
}

.vpp-step-content {
  flex: 1;
}

.vpp-step-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.vpp-step-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

/* ===== Skill Assessment ===== */
.skill-section {
  margin-bottom: 20rpx;
}

.skill-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #2e7d32;
  display: block;
  margin-bottom: 12rpx;
  padding: 8rpx 16rpx;
  background: #e8f5e9;
  border-radius: 6rpx;
  border-left: 4rpx solid #07C160;
}

.skill-divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

.skill-conclusion {
  background: #fff8e1;
  border-radius: 10rpx;
  padding: 20rpx;
  border-left: 6rpx solid #ff9800;
  display: flex;
  align-items: flex-start;
}

.conclusion-icon {
  font-size: 40rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.conclusion-text {
  flex: 1;
  font-size: 26rpx;
  color: #5d4037;
  line-height: 1.7;
}

.conclusion-text .bold {
  font-weight: 700;
  color: #e65100;
}

/* ===== Footer ===== */
.footer-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #bbb;
}
