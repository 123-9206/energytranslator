.container {
  padding-bottom: 40rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.hero-section {
  padding: 40rpx 24rpx 24rpx;
}

.hero-card {
  background: linear-gradient(135deg, #07C160 0%, #05a34e 100%);
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.hero-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16rpx;
}

.hero-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.hero-currency {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 8rpx;
}

.hero-value {
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
}

.loading-tip {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

.earnings-section {
  padding: 0 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.earnings-list {
  display: flex;
  flex-direction: column;
}

.earnings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 12rpx;
}

.item-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-date {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.item-right {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.item-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #fa5151;
}

.item-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 8rpx;
}
