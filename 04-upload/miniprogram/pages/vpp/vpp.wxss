.container {
  padding-bottom: 140rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.summary-header {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 36rpx 24rpx;
  background: linear-gradient(135deg, #07C160 0%, #05a34e 100%);
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.s-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.s-value.green { color: #fff; }
.s-value.gold { color: #ffd700; }

.s-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.summary-divider {
  width: 2rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.3);
}

.tab-bar {
  display: flex;
  padding: 24rpx;
  gap: 16rpx;
  background: #fff;
}

.tab-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
}

.tab-item.active {
  background: #07C160;
  color: #fff;
  font-weight: 600;
}

.loading-tip {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

.resource-list {
  padding: 16rpx 24rpx;
}

.resource-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.resource-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.resource-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.status-tag.green { background: rgba(7, 193, 96, 0.12); color: #07C160; }
.status-tag.gray { background: rgba(153, 153, 153, 0.12); color: #999; }
.status-tag.orange { background: rgba(255, 152, 0, 0.12); color: #ff9800; }

.resource-body {
  display: flex;
  gap: 32rpx;
}

.resource-info {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-value.earnings { color: #fa5151; }

.activity-list {
  padding: 16rpx 24rpx;
}

.activity-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.activity-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.activity-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.activity-status.active { background: rgba(7, 193, 96, 0.12); color: #07C160; }
.activity-status.upcoming { background: rgba(0, 122, 255, 0.12); color: #007aff; }
.activity-status.ended { background: rgba(153, 153, 153, 0.12); color: #999; }

.activity-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.activity-time {
  font-size: 24rpx;
  color: #999;
}

.activity-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 8rpx;
}

.tag.subsidy {
  background: rgba(250, 81, 81, 0.1);
  color: #fa5151;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 40rpx;
}
