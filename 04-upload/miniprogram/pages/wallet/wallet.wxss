/* pages/wallet/wallet.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f7fa;
}
.loading-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

.hero-card {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  border-radius: 20rpx;
  padding: 44rpx 40rpx;
  margin-bottom: 24rpx;
  color: #fff;
}
.hero-label { font-size: 28rpx; opacity: 0.85; }
.hero-value { display: flex; align-items: baseline; margin: 16rpx 0; }
.hero-num { font-size: 72rpx; font-weight: 700; }
.hero-unit { font-size: 30rpx; opacity: 0.85; margin-left: 10rpx; }
.hero-sub { font-size: 24rpx; opacity: 0.8; }

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.grid-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  text-align: center;
}
.g-val {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #07C160;
}
.g-label { font-size: 24rpx; color: #999; margin-top: 10rpx; }

.tip-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border: 2rpx solid #eaf2ec;
  border-radius: 16rpx;
  padding: 28rpx;
}
.tip-text { font-size: 26rpx; color: #333; flex: 1; }
.tip-arrow { font-size: 40rpx; color: #07C160; }

.update-tip {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 20rpx;
}
