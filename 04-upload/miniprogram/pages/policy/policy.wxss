/* pages/policy/policy.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  padding-bottom: 60rpx;
}

.loading-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.summary-section {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}

.summary-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.summary-row {
  display: flex;
}

.summary-item {
  flex: 1;
  padding: 10rpx 0;
}

.summary-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.summary-value.green {
  color: #d4f7e4;
}

.summary-value.orange {
  color: #ffe1a8;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.summary-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.type-tabs {
  white-space: nowrap;
  margin: 20rpx 0;
}

.type-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}

.type-tab.active {
  background: #07C160;
  color: #fff;
}

.policy-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.policy-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.policy-type {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #e8f8ef;
  color: #07C160;
}

.policy-type.green_power {
  background: #e6f7ff;
  color: #1989fa;
}

.policy-type.carbon {
  background: #fff3e0;
  color: #ff9800;
}

.policy-type.subsidy {
  background: #fdeaea;
  color: #FA5151;
}

.match-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  color: #999;
}

.match-badge.matched {
  background: #07C160;
  color: #fff;
}

.policy-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
}

.policy-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  line-height: 1.5;
}

.policy-rows {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.policy-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 24rpx;
}

.policy-label {
  color: #999;
}

.policy-value {
  color: #333;
}

.policy-value.highlight {
  color: #07C160;
  font-weight: 600;
}

.policy-value.source {
  max-width: 420rpx;
  text-align: right;
  color: #1989fa;
}

.apply-btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.apply-btn.disabled {
  background: #e8e8e8;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
