/* pages/partner/partner.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f7fa;
}
.loading-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

.calc-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.card-title { font-size: 32rpx; font-weight: 600; color: #333; }
.calc-desc { font-size: 24rpx; color: #999; margin: 10rpx 0 20rpx; line-height: 1.5; }

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-label { font-size: 28rpx; color: #333; }
.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #07C160;
  margin-left: 20rpx;
}

.calc-btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-calc {
  flex: 1;
  background: #07C160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 14rpx 0;
  line-height: 1.6;
}
.btn-reset {
  width: 160rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 14rpx 0;
  line-height: 1.6;
}

.calc-result {
  margin-top: 24rpx;
  background: #f7fbf9;
  border-radius: 12rpx;
  padding: 20rpx;
}
.cr-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 0;
}
.cr-val { font-weight: 600; color: #333; }
.cr-val.green { color: #07C160; }
.cr-val.orange { color: #FA8C16; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin: 16rpx 4rpx 20rpx;
}
.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 50rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.empty-sub { font-size: 24rpx; color: #bbb; line-height: 1.5; padding: 0 20rpx; }

.partner-card, .share-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.p-head, .s-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.p-name, .s-name { font-size: 30rpx; font-weight: 600; color: #333; }
.p-status, .s-status {
  font-size: 22rpx;
  color: #07C160;
  background: #eaf7ef;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.p-meta { display: flex; flex-direction: column; gap: 8rpx; }
.p-meta text { font-size: 25rpx; color: #888; }

.s-period { font-size: 24rpx; color: #999; margin-bottom: 16rpx; }
.s-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}
.s-item { text-align: center; }
.s-val { display: block; font-size: 30rpx; font-weight: 700; color: #333; }
.s-val.green { color: #07C160; }
.s-val.orange { color: #FA8C16; }
.s-key { font-size: 22rpx; color: #999; margin-top: 6rpx; }
