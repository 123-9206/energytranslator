/* pages/quota/quota.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f7fa;
}

/* 加载中 */
.loading-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 配额概览卡片 */
.quota-card {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  color: #fff;
}
.quota-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.quota-year {
  font-size: 28rpx;
  opacity: 0.85;
}
.quota-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.2);
}
.quota-status.danger {
  background: rgba(255,77,79,0.3);
}
.quota-value {
  text-align: center;
  margin-bottom: 20rpx;
}
.quota-number {
  font-size: 72rpx;
  font-weight: 700;
}
.quota-unit {
  font-size: 28rpx;
  opacity: 0.85;
  margin-left: 8rpx;
}
.quota-label {
  font-size: 26rpx;
  opacity: 0.75;
}

/* 进度条 */
.progress-wrap {
  margin-bottom: 24rpx;
}
.progress-bar {
  height: 12rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}
.progress-fill.warning {
  background: #FFD43B;
}
.progress-fill.danger {
  background: #FF4D4F;
}
.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  opacity: 0.8;
}

/* 配额明细网格 */
.quota-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.quota-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}
.quota-item.full {
  grid-column: 1 / -1;
}
.item-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}
.item-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 历史记录 */
.history-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}
.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.history-item:last-child {
  border-bottom: none;
}
.history-year {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}
.history-detail {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}
.history-used {
  font-size: 26rpx;
  color: #666;
}
.history-rate {
  font-size: 24rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  color: #999;
}
.history-rate.warning {
  background: #FFF7E6;
  color: #FA8C16;
}
.history-rate.danger {
  background: #FFF1F0;
  color: #FF4D4F;
}

/* 提示信息 */
.tip-card {
  background: #FFF7E6;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}
.tip-text {
  font-size: 26rpx;
  color: #AD6800;
  line-height: 1.6;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 60rpx 0;
}
