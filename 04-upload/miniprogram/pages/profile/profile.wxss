.container {
  padding-bottom: 40rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.user-section {
  background: linear-gradient(135deg, #07C160 0%, #06ad56 100%);
  padding: 48rpx 32rpx 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
}

.user-card.guest {
  cursor: pointer;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.user-info {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.enterprise {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.login-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}

.arrow {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: auto;
  transform: rotate(90deg);
}

.menu-section {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-label {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 22rpx;
  color: #ccc;
  transform: rotate(90deg);
}

.logout-section {
  padding: 40rpx 24rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #fa5151;
  font-size: 30rpx;
  border-radius: 16rpx;
  border: none;
  text-align: center;
}

.logout-btn::after {
  border: none;
}

/* 版本信息 */
.version-section {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
}

.version-text {
  font-size: 24rpx;
  color: #999;
}

.version-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #07C160;
  padding: 6rpx 20rpx;
  border: 1rpx solid #07C160;
  border-radius: 24rpx;
}
