/* pages/profile/login/login.wxss */

.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #07C160 0%, #06AD56 30%, #f5f5f5 30%);
  padding: 0 40rpx;
}

/* Logo */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 60rpx;
}

.logo-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.logo-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.logo-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

/* 表单卡片 */
.form-card {
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  margin-top: 20rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.login-btn {
  margin-top: 40rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
}

.login-btn[disabled] {
  opacity: 0.6;
}

.switch-mode {
  text-align: center;
  margin-top: 32rpx;
  padding: 16rpx 0;
}

.demo-login {
  margin-top: 24rpx;
  padding: 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  border: 2rpx solid #07C160;
  background: #ffffff;
  text-align: center;
}

.demo-login .demo-login-text {
  color: #07C160;
  font-size: 28rpx;
  font-weight: 500;
}
