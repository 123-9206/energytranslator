<!-- pages/profile/login/login.wxml -->
<view class="login-page">
  <!-- Logo区域 -->
  <view class="logo-area">
    <view class="logo-icon">⚡</view>
    <text class="logo-title">能耗翻译官</text>
    <text class="logo-subtitle">智能能源管理系统</text>
  </view>

  <!-- 表单区域 -->
  <view class="form-card card">
    <!-- 登录表单 -->
    <block wx:if="{{isLogin}}">
      <view class="form-group">
        <text class="form-label">用户名</text>
        <input class="input-field" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput" />
      </view>
      <view class="form-group">
        <text class="form-label">密码</text>
        <input class="input-field" password placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />
      </view>
      <button class="btn-primary login-btn" bindtap="onLogin" loading="{{loading}}" disabled="{{loading}}">
        登 录
      </button>
      <!-- 演示账号一键体验 -->
      <view class="demo-login" bindtap="onDemoLogin">
        <text class="demo-login-text">没有账号？一键体验演示企业</text>
      </view>
      <view class="switch-mode" bindtap="switchMode">
        <text class="text-primary text-sm">还没有账号？立即注册</text>
      </view>
    </block>

    <!-- 注册表单 -->
    <block wx:else>
      <view class="form-group">
        <text class="form-label">用户名</text>
        <input class="input-field" placeholder="请输入用户名（至少3位）" value="{{username}}" bindinput="onUsernameInput" />
      </view>
      <view class="form-group">
        <text class="form-label">密码</text>
        <input class="input-field" password placeholder="请输入密码（至少6位）" value="{{password}}" bindinput="onPasswordInput" />
      </view>
      <view class="form-group">
        <text class="form-label">确认密码</text>
        <input class="input-field" password placeholder="请再次输入密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
      </view>
      <view class="form-group">
        <text class="form-label">企业名称</text>
        <input class="input-field" placeholder="请输入企业名称" value="{{enterpriseName}}" bindinput="onEnterpriseNameInput" />
      </view>
      <view class="form-group">
        <text class="form-label">手机号</text>
        <input class="input-field" type="number" placeholder="请输入手机号（选填）" value="{{phone}}" bindinput="onPhoneInput" maxlength="11" />
      </view>
      <button class="btn-primary login-btn" bindtap="onRegister" loading="{{loading}}" disabled="{{loading}}">
        注 册
      </button>
      <view class="switch-mode" bindtap="switchMode">
        <text class="text-primary text-sm">已有账号？返回登录</text>
      </view>
    </block>
  </view>
</view>
